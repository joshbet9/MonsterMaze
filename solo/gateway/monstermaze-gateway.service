[Unit]
Description=Monster Maze Minecraft wake gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/monster-gateway
EnvironmentFile=/etc/monstermaze-gateway.env
ExecStart=/usr/bin/python3 /home/ubuntu/monster-gateway/monstermaze_gateway.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

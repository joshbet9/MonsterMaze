[Unit]
Description=Monster Maze local server status API
After=network-online.target monstermaze-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/monster-gateway
EnvironmentFile=/etc/monstermaze-gateway.env
ExecStart=/usr/bin/python3 /home/ubuntu/monster-gateway/status_api.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

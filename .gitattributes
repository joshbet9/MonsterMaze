# Keep text files normalized across Windows and Linux development environments.
* text=auto eol=lf

# Windows scripts are text, but should retain their intended LF repository form.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
